{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "none",
			"semicolons": "asNeeded",
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"arrowParentheses": "always",
			"quoteProperties": "asNeeded",
			"lineWidth": 80,
			"indentWidth": 2,
			"lineEnding": "lf"
		}
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"complexity": {
				"noCommaOperator": "off"
			},
			"correctness": {
				"useHookAtTopLevel": "error",
				"useExhaustiveDependencies": "warn",
				"noUnusedImports": "off"
			}
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}
